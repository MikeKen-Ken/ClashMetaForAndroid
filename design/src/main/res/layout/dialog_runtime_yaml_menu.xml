<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="master"
            type="com.github.kr328.clash.design.ProfilesDesign" />
        <variable
            name="self"
            type="android.app.Dialog" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestUploadRuntimeYaml(self)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/ic_baseline_attach_file"
            app:text="@string/upload_runtime_yaml" />

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestDownloadRuntimeYaml(self)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/ic_baseline_cloud_download"
            app:text="@string/download_runtime_yaml" />
    </LinearLayout>
</layout>
